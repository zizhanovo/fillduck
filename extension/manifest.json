{
  "manifest_version": 3,
  "name": "填鸭 FillDuck",
  "version": "0.1.0",
  "description": "选一张资料卡，一口填完当前网页表单。资料只存在本机。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开填鸭侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "scripting", "storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["https://www.12315.cn/*"],
  "optional_host_permissions": ["<all_urls>"]
}
